{
  "$schema": "https://opencode.ai/config.json",
  "version": "1.0.0",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "opencode": {
      "models": {
        "muse-spark-1.3-contributor-free": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "project": {
    "name": "Python-Material",
    "description": "Python study + logic-building practice: exercises under src/python_material (one folder per topic with code + PROBLEM.md), pytest suite under tests/ mirroring the package, runnable demos under demos/. Python 3.14, src layout, ruff + mypy gated.",
    "type": "python"
  },
  "instructions": ["AGENTS.md", "README.md", "docs/STYLE_GUIDE.md", "docs/COMMIT_CONVENTION.md"],
  "agents": {
    "default": "python-practice-assistant",
    "list": [
      "python-practice-assistant",
      "code-reviewer",
      "test-writer",
      "documentation-writer"
    ]
  },
  "skills": {
    "enabled": [
      "python-development",
      "testing-strategy"
    ]
  },
  "commands": {
    "custom": [
      "python-build",
      "python-test",
      "python-run",
      "python-clean",
      "python-lint",
      "build",
      "test",
      "lint",
      "format",
      "run",
      "clean"
    ]
  },
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny"
    }
  },
  "lsp": true,
  "plugin": [],
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
